{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && cargo run --quiet -- hook",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
